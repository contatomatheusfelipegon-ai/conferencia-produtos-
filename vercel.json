{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/pedidos", "dest": "/public/pedidos.html" },
    { "src": "/historico", "dest": "/public/historico.html" },
    { "src": "/", "dest": "/public/index.html" }
  ]
}
